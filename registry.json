{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "gasboost-ui",
  "homepage": "https://github.com/gasboost/ui",
  "items": [
    {
      "name": "appsscript-client",
      "type": "registry:item",
      "title": "Apps Script Client",
      "description": "Typed GAS BOOST RPC client with shared authentication storage and metadata.",
      "dependencies": [
        "@gasboost/client@^0.6.0",
        "@gasboost/auth-client@^0.6.0"
      ],
      "files": [
        {
          "path": "src/frontend/lib/appsscript.ts",
          "type": "registry:file",
          "target": "~/src/frontend/lib/appsscript.ts"
        }
      ]
    },
    {
      "name": "auth-client",
      "type": "registry:item",
      "title": "GAS BOOST Auth Client",
      "description": "GAS BOOST authentication using the RPC client's shared storage.",
      "dependencies": [
        "@gasboost/auth-client@^0.6.0"
      ],
      "registryDependencies": [
        "gasboost/ui/appsscript-client"
      ],
      "files": [
        {
          "path": "src/frontend/lib/auth.ts",
          "type": "registry:file",
          "target": "~/src/frontend/lib/auth.ts"
        }
      ]
    },
    {
      "name": "auth-context",
      "type": "registry:item",
      "title": "GAS BOOST Auth Context",
      "description": "React context for GAS BOOST authentication.",
      "dependencies": [
        "@gasboost/react@^0.4.1"
      ],
      "registryDependencies": [
        "gasboost/ui/auth-client"
      ],
      "files": [
        {
          "path": "src/frontend/contexts/AuthContext.tsx",
          "type": "registry:file",
          "target": "~/src/frontend/contexts/AuthContext.tsx"
        }
      ]
    },
    {
      "name": "guard",
      "type": "registry:item",
      "title": "GAS BOOST Guard",
      "description": "React components for authentication and permission guarding.",
      "dependencies": [
        "@gasboost/auth@^0.10.0",
        "react-router-dom@^7.18.5",
        "@gasboost/bootstrap@^0.4.0",
        "@gasboost/client@^0.6.0",
        "@tanstack/react-query@^5.107.1"
      ],
      "registryDependencies": [
        "gasboost/ui/auth-context",
        "alert",
        "button",
        "card"
      ],
      "files": [
        {
          "path": "src/frontend/components/Guard.tsx",
          "type": "registry:file",
          "target": "~/src/frontend/components/Guard.tsx"
        },
        {
          "path": "src/shared/routes.ts",
          "type": "registry:file",
          "target": "~/src/shared/routes.ts"
        },
        {
          "path": "src/frontend/lib/bootstrap.ts",
          "type": "registry:file",
          "target": "~/src/frontend/lib/bootstrap.ts"
        },
        {
          "path": "src/frontend/features/bootstrap/BootstrapPage.tsx",
          "type": "registry:file",
          "target": "~/src/frontend/features/bootstrap/BootstrapPage.tsx"
        },
        {
          "path": "src/frontend/features/bootstrap/mutations.ts",
          "type": "registry:file",
          "target": "~/src/frontend/features/bootstrap/mutations.ts"
        }
      ]
    },
    {
      "name": "bootstrap",
      "type": "registry:item",
      "title": "GAS BOOST Bootstrap",
      "description": "First-run initialization gate and setup page with typed RPC errors and manual retry.",
      "dependencies": [
        "@gasboost/bootstrap@^0.4.0",
        "@gasboost/client@^0.6.0",
        "@tanstack/react-query@^5.107.1",
        "react-router-dom@^7.18.5"
      ],
      "registryDependencies": [
        "gasboost/ui/guard",
        "alert",
        "button",
        "card"
      ],
      "files": [
        {
          "path": "src/frontend/lib/bootstrap.ts",
          "type": "registry:file",
          "target": "~/src/frontend/lib/bootstrap.ts"
        },
        {
          "path": "src/frontend/features/bootstrap/BootstrapPage.tsx",
          "type": "registry:file",
          "target": "~/src/frontend/features/bootstrap/BootstrapPage.tsx"
        },
        {
          "path": "src/frontend/features/bootstrap/mutations.ts",
          "type": "registry:file",
          "target": "~/src/frontend/features/bootstrap/mutations.ts"
        }
      ]
    }
  ]
}
